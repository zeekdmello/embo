{
  "name": "@embo/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts src/scripts/seed.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --external:express --external:mongoose --external:cors --external:dotenv",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "mongoose": "8.8.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "esbuild": "0.24.0",
    "tsx": "4.19.2"
  }
}
