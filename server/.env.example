# MongoDB connection string. Local:  mongodb://127.0.0.1:27017/embo
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/embo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/embo

# Port the Express server listens on (hosts like Render set this automatically).
PORT=4000

# Optional: only if the React app is hosted on a different domain (e.g. https://embo.vercel.app).
# Comma-separate several origins. Leave empty when Express serves the React build itself.
CLIENT_ORIGIN=

# Load the sample dataset automatically when the database is empty (true/false).
SEED_ON_EMPTY=true
