# MongoDB connection string. Local MongoDB:  mongodb://127.0.0.1:27017/embo
MONGODB_URI=mongodb://127.0.0.1:27017/embo

# Port the Express server listens on.
PORT=4000

# Optional: only if the React app is served from a different domain than the API.
# Comma-separate several origins. Leave empty when Express serves the React build itself.
CLIENT_ORIGIN=

# Load the sample dataset automatically when the database is empty (true/false).
SEED_ON_EMPTY=true
